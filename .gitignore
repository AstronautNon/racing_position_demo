# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

