# ---------------------------------------------------------------
# 素材视频：体积大（约 385 MB），不入库。
# 需要时从原始来源重新获取；素材清单与体检结论见 项目规划.md §13。
# ---------------------------------------------------------------
drift/*.mov
drift/*.mp4

# 运行产物：可由代码再生成，入库会让仓库持续膨胀。
# 交付用的曲线图/表格请放到 outputs/reports/（该目录入库）。
outputs/cache/
outputs/**/*.npz
outputs/**/*.npy

# 标注台的裁图与自包含页面：共约 40 MB，全部可由代码再生成
#   crops/  用 python -m src.select_frames --all 预生成（约 1 分钟）
#   web/    用 python -m src.annotate --export --all 生成
# 但这些**不入库**：
#   outputs/annotations/queue/*.csv   选帧结果，是标注的可复现基准
#   outputs/annotations/<名>.csv      人工标注，是真正要保留的劳动成果
outputs/annotations/crops/
outputs/annotations/web/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
